FROM golang:1.24-bullseye AS builder
ENV CGO_ENABLED=1
RUN apt-get update && apt-get install -y \
    git \
    librdkafka-dev \
    pkg-config \
    build-essential

WORKDIR /app

# Copy the message-broker source code to the correct location for replace directive
COPY ./message-broker ../message-broker

# Copy go.mod and go.sum for order-service
COPY ./order-service/go.mod ./order-service/go.sum ./

# Download dependencies (the replace directive will work now)
RUN go mod download

# Copy the rest of the order-service source code
COPY ./order-service .

# Build the service
RUN go build -o order-service .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y \
    librdkafka1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /root/
COPY --from=builder /app/order-service .
EXPOSE 50053
CMD ["./order-service"]