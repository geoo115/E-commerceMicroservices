# Build Stage
FROM golang:1.24-alpine AS builder

# Install git (required for module downloads)
RUN apk update && apk add --no-cache git

WORKDIR /app

# Copy all service directories to the correct locations for replace directives
COPY ./auth-service ../auth-service
COPY ./cart-service ../cart-service
COPY ./inventory-service ../inventory-service
COPY ./order-service ../order-service
COPY ./payment-service ../payment-service
COPY ./product-service ../product-service
COPY ./review-service ../review-service
COPY ./message-broker ../message-broker

# Copy api-gateway go.mod and go.sum first
COPY ./api-gateway/go.mod ./api-gateway/go.sum ./

# Download dependencies
RUN go mod download

# Copy the api-gateway source code
COPY ./api-gateway .

# Build the binary
RUN go build -o api-gateway .

# Final Stage
FROM alpine:latest

WORKDIR /root/

# Copy the built binary from the builder stage
COPY --from=builder /app/api-gateway .

# Expose the port defined in config.yaml (default: 8080)
EXPOSE 8080

# Command to run the API Gateway
CMD ["./api-gateway"]
