# Copy to .env and adjust. docker compose reads it automatically.
# Values here are for local development only.

# HMAC secret for access tokens (at least 32 bytes). Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32-byte-secret-value
JWT_TTL=24h

# Seeded admin account (created on first start of auth-service).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-password-change-me

POSTGRES_PASSWORD=postgres
GRAFANA_ADMIN_PASSWORD=admin
LOG_LEVEL=info

# Integration tests (make test-integration) use the Postgres container on port 15432.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:15432/ecommerce_test?sslmode=disable
